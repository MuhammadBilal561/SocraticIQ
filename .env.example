# SocratIQ frontend environment variables
#
# Copy this file to `.env.local` and fill in your own values.
# Never commit real credentials.

# Your Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon (public) key. The anon key is safe for the browser;
# it only grants access to your Supabase project's public auth/client API.
VITE_SUPABASE_ANON_KEY=

# Optional: enable the offline mock-AI fallback during local development.
# Keep unset or "false" for production. Never enable in production builds,
# otherwise backend failures would be silently hidden.
# VITE_ENABLE_MOCK_AI=true
